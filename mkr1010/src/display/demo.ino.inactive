#include <Adafruit_NeoPixel.h>

Adafruit_NeoPixel strip(256, 8, NEO_GRB + NEO_KHZ800);  // 8x32 WS2812B on D8

// Rød_Advarselstrekant, top row first; '#' = C1292E, '.' = off
const char *pattern[8] = {
  "....#....",
  "...#.#...",
  "..#.#.#..",
  "..#.#.#..",
  ".#.....#.",
  ".#..#..#.",
  "#.......#",
  "#########",
};

// LED 0 bottom-left, columns of 8, zig-zag: even columns run up, odd columns run down
int ledIndex(int col, int row) {  // row 0 = top
  return col * 8 + (col % 2 == 0 ? 7 - row : row);
}

void setup() {
  strip.begin();
  strip.setBrightness(77);  // ~30% of 255
  strip.clear();
  for (int row = 0; row < 8; row++)
    for (int col = 0; col < 9; col++)
      if (pattern[row][col] == '#') strip.setPixelColor(ledIndex(col, row), strip.Color(0xC1, 0x29, 0x2E));
  strip.show();
}

void loop() { strip.show(); delay(100); }  // resend constantly in case the first frame was missed

